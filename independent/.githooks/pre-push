#!/bin/sh
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$remote_ref" in
        refs/heads/feat/independent-*|refs/heads/fix/independent-*|refs/heads/docs/independent-*|refs/heads/experiment/independent-*) ;;
        *) echo "Independent project: refusing push to $remote_ref." >&2; exit 1 ;;
    esac
done
