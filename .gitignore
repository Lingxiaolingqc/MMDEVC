.venv/
.venv-cuda/
venv/
__pycache__/
*.py[cod]
*.egg-info/
/build/
/dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# Local editor and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log

